      "get": {
        "description": "Retrieve all pets paginated",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/users": {
      "get": {
        "description": "Retrieve all users (admin only)",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/adoption/adoptions": {
      "get": {
        "description": "Retrieve all adoptions (admin only)",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "type": "string"
          }
