{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "REST API",
    "description": "Pet Adopt API contract specification"
  },
  "host": "petadopt.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
